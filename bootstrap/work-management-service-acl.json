    {
      "resource": "project_stage_models",
      "_why": "Owner-authored reference data (framework by Owner, stations filled in later by the business line). No role -- including this one -- gets write access; it is edited only through the NocoBase admin UI.",
      "_only_actions": true,
      "actions": [
        {
          "name": "view",
          "fields": [
            "id",
            "model_key",
            "name",
            "description",
            "stages",
            "version",
            "status"
          ]
        }
      ]
    },
    {
      "resource": "project_stage_events",
      "_why": "GET /api/work-management projects stage_track (per-station first-entry timestamps and the event list) from these rows. Written only through POST /api/agent-stage-events under the separate Report Writer service identity -- this role is read-only.",
      "_only_actions": true,
      "actions": [
        {
          "name": "view",
          "fields": [
            "id",
            "project_id",
            "stage_code",
            "station_code",
            "entered_at",
            "recorded_at",
            "note",
            "submitted_by_id",
            "backfilled"
          ]
        }
      ]
    },
    {
      "resource": "attachments",
      "_why": "The Owner's browser upload on the Report detail page (POST /api/project-reports/{id}/attachments) stores the file on the Owner's behalf, exactly the way the credential-resolved Agent path already does through the separate Report Writer service identity. It never deletes or updates one, so create and view are the only actions.",
      "_meta_why": "meta is NocoBase's own JSON column on the file-manager attachments collection. sha256 is written to it as an ordinary extra multipart field at upload time; the field cannot persist unless meta itself is in this allowlist.",
      "_url_why": "url and preview are NocoBase getters computed from storageId and path against the storage engine record, not plain columns; verified empirically that omitting storageId/path from this allowlist makes url resolve to null even for an attachment just uploaded through this same role. See bootstrap/report-writer-acl.json's matching note.",
      "actions": [
        {
          "name": "create",
          "fields": [
            "filename",
            "url",
            "size",
            "mimetype",
            "storageId",
            "title",
            "meta"
          ]
        },
        {
          "name": "view",
          "fields": [
            "id",
            "filename",
            "url",
            "size",
            "mimetype",
            "createdAt",
            "meta",
            "storageId",
            "path"
          ]
        }
      ]
    },
